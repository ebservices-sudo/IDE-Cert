# Copy to .dev.vars for local development (never commit .dev.vars).
# In production set each one with: npx wrangler secret put NAME

# Resend (https://resend.com) API key for order, quote and contact emails.
# Leave empty locally: emails are then printed to the dev server console.
RESEND_API_KEY=

# Cloudflare Turnstile secret. This is Cloudflare's official test secret (always passes).
# The public site key is a build variable: NEXT_PUBLIC_TURNSTILE_SITE_KEY (see README).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
