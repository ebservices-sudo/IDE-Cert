{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers deployment via OpenNext (`npm run deploy`, or Workers Builds on push).
  "name": "ide-cert-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // Requests, messages, accounts and price-list imports. No database_id: Wrangler
      // creates the database on the first deploy (free plan) and reuses it after.
      "binding": "DB",
      "database_name": "ide-cert-db",
      "migrations_dir": "migrations"
    }
  ],
  "images": {
    // next/image optimisation through Cloudflare Images.
    "binding": "IMAGES"
  },
  "vars": {
    // Public, non-secret settings. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, …)
    // go in .dev.vars locally and `npx wrangler secret put NAME` in production.
    "SHOP_NOTIFY_EMAIL": "idecert.shpk@gmail.com",
    "MAIL_FROM": "IDE Cert <shop@ide-cert.com>"
  },
  "observability": {
    "enabled": true
  }
}
